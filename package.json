{
  "name": "@hamolus/core",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Hamolus core — Cloudflare Worker API engine. Hono + Drizzle + D1, dynamically-defined CRUD /api/:collection, multi-land (lands/colonies), media & file libraries, plugins, seed export/restore.",
  "main": "dist/index.js",
  "files": [
    "dist",
    "src",
    "scripts",
    "docs",
    "wrangler.jsonc",
    "drizzle.config.ts"
  ],
  "scripts": {
    "dev": "wrangler dev --port 8789 --ip 0.0.0.0",
    "build": "rm -rf dist && wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@hamolus/types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.0",
    "wrangler": "^4.135.0"
  }
}
