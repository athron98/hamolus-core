# Example env for local development — copy into .dev.vars as needed.
# .dev.vars is gitignored; production creds go in `wrangler secret put`.

# --- @hamolus/core (wrangler dev reads .dev.vars) ---
JWT_SECRET=change-me-in-development
ADMIN_KEY=change-me-in-development
# PUBLIC_GETS=true
# CORE_MODE=independent        # independent | centralized | proxy | bridge
# DEFAULT_LAND=default